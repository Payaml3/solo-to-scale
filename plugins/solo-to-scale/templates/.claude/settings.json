{
  "extraKnownMarketplaces": {
    "solo-to-scale": {
      "source": { "source": "github", "repo": "Payaml3/solo-to-scale" }
    }
  },
  "enabledPlugins": {
    "solo-to-scale@solo-to-scale": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/.claude/statusline.py\""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git checkout *)", "Bash(git switch *)", "Bash(git push -u origin *)", "Bash(git fetch *)",
      "Bash(python tools/*)", "Bash(python3 tools/*)", "Bash(python -m pytest *)", "Bash(python3 -m pytest *)",
      "Bash(make test-area *)", "Bash(make governance)", "Bash(gh issue view *)", "Bash(gh pr view *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Read(./**/secrets/**)",
      "Bash(git push --force *)", "Bash(git push origin main)", "Bash(git push origin HEAD:main)"
    ]
  }
}
